# Root-level ignores for the monorepo

# Secrets / environment files
.env
.env.backup
.env.production
.env.local

# ────────── FRONTEND (Angular) ──────────
frontend/node_modules/
frontend/dist/
frontend/.angular/cache/
frontend/coverage/
frontend/tmp/
frontend/out-tsc/
frontend/npm-debug.log
frontend/yarn-error.log
frontend/.sass-cache/
frontend/connect.lock
frontend/libpeerconnection.log
frontend/testem.log
frontend/typings/

# ────────── BACKEND (Laravel) ──────────
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/pail/
backend/.phpunit.result.cache
backend/.phpunit.cache/
backend/.env.render
backend/auth.json
backend/Homestead.json
backend/Homestead.yaml

# ────────── IDE / OS ──────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
